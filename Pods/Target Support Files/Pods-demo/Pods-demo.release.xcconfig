ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Aspects" "${PODS_CONFIGURATION_BUILD_DIR}/WCDB.swift" "${PODS_CONFIGURATION_BUILD_DIR}/WCDBOptimizedSQLCipher" "${PODS_CONFIGURATION_BUILD_DIR}/YYCache" "${PODS_CONFIGURATION_BUILD_DIR}/YYCategories" "${PODS_CONFIGURATION_BUILD_DIR}/YYDispatchQueuePool" "${PODS_CONFIGURATION_BUILD_DIR}/YYImage" "${PODS_CONFIGURATION_BUILD_DIR}/YYKeyboardManager" "${PODS_CONFIGURATION_BUILD_DIR}/YYModel" "${PODS_CONFIGURATION_BUILD_DIR}/YYWebImage"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Aspects/Aspects.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WCDB.swift/WCDBSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WCDBOptimizedSQLCipher/sqlcipher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYCache/YYCache.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYCategories/YYCategories.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYDispatchQueuePool/YYDispatchQueuePool.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYImage/YYImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYKeyboardManager/YYKeyboardManager.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYModel/YYModel.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYWebImage/YYWebImage.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Aspects/Aspects.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/WCDB.swift/WCDBSwift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/WCDBOptimizedSQLCipher/sqlcipher.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYCache/YYCache.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYCategories/YYCategories.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYDispatchQueuePool/YYDispatchQueuePool.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYImage/YYImage.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYKeyboardManager/YYKeyboardManager.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYModel/YYModel.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYWebImage/YYWebImage.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Aspects" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/WCDB.swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/WCDBOptimizedSQLCipher" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYCache" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYCategories" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYDispatchQueuePool" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYImage" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYKeyboardManager" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYModel" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYWebImage"
OTHER_LDFLAGS = $(inherited) -l"c++" -l"sqlite3" -l"z" -framework "Accelerate" -framework "Aspects" -framework "AssetsLibrary" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreText" -framework "Foundation" -framework "ImageIO" -framework "MobileCoreServices" -framework "QuartzCore" -framework "Security" -framework "UIKit" -framework "WCDBSwift" -framework "YYCache" -framework "YYCategories" -framework "YYDispatchQueuePool" -framework "YYImage" -framework "YYKeyboardManager" -framework "YYModel" -framework "YYWebImage" -framework "sqlcipher"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Aspects" "-F${PODS_CONFIGURATION_BUILD_DIR}/WCDB.swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/WCDBOptimizedSQLCipher" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYCache" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYCategories" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYDispatchQueuePool" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYKeyboardManager" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYModel" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYWebImage"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
